---
import '../styles/sermon-card.css';
const { sermon } = Astro.props;
---
<section class="sermon-card" class:list={{ 'sermon-card-live': sermon.isLive }} aria-labelledby="sermon-card-title" data-preview={sermon.isPreview}>
  <svg class="sermon-card-bible" viewBox="0 0 180 180" fill="none" aria-hidden="true" focusable="false">
    <rect x="38" y="20" width="107" height="139" rx="12" />
    <path d="M53 20v139M53 141h92M69 159h76M95 48v48M77 65h36M73 117h53" />
  </svg>
  <div class="sermon-card-topline">
    <p class="sermon-card-status"><span class="sermon-card-dot" aria-hidden="true"></span>{sermon.statusLabel}</p>
  </div>
  <p class="sermon-card-eyebrow">Prédica</p>
  <h2 id="sermon-card-title">{sermon.title || sermon.preacher || 'Mensaje de la reunión'}</h2>
  {sermon.title && sermon.preacher && <p class="sermon-card-preacher">{sermon.preacher}</p>}
  {sermon.outlineUrl ? (
    <a class="sermon-card-action" href={sermon.outlineUrl} target="_blank" rel="noopener noreferrer">Abrir mensaje<span aria-hidden="true">&gt;</span><span class="sr-only"> (abre en una pestaña nueva)</span></a>
  ) : (
    <button class="sermon-card-action" disabled aria-label="Abrir mensaje: documento no disponible">Abrir mensaje<span aria-hidden="true">&gt;</span></button>
  )}
</section>

