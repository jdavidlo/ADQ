---
import smallGroupsImage from '../img/grupos pequeños.webp';
import { getSmallGroups } from '../services/small-groups.js';
const smallGroups = getSmallGroups();
---

<article class="small-groups-card" aria-labelledby="small-groups-card-title">
  <h2 class="sr-only" id="small-groups-card-title">{smallGroups.title}</h2>
  <img
    class="small-groups-card-image"
    src={smallGroupsImage.src}
    alt={smallGroups.imageAlt}
    width={1920}
    height={955}
    loading="lazy"
    decoding="async"
    fetchpriority="low"
  />
  <button
    class="small-groups-more-button"
    type="button"
    aria-haspopup="dialog"
    aria-controls="small-groups-sheet"
    data-small-groups-open
  >
    <span>Ver más</span>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
  </button>
</article>

<div class="small-groups-sheet-layer" data-small-groups-sheet-layer hidden>
  <button class="small-groups-sheet-backdrop" type="button" tabindex="-1" aria-label="Cerrar Grupos Pequeños" data-small-groups-sheet-backdrop></button>
  <section
    id="small-groups-sheet"
    class="small-groups-sheet"
    role="dialog"
    aria-modal="true"
    aria-labelledby="small-groups-sheet-title"
    tabindex="-1"
    data-state="closed"
    data-small-groups-sheet
  >
    <h2 class="sr-only" id="small-groups-sheet-title">{smallGroups.title}</h2>
    <button class="small-groups-sheet-handle" type="button" aria-label="Cerrar Grupos Pequeños" data-small-groups-sheet-close>
      <span aria-hidden="true"></span>
    </button>
    <iframe
      class="small-groups-sheet-frame"
      title="Grupos Pequeños ADQ"
      data-src={smallGroups.pageUrl}
      loading="eager"
      referrerpolicy="strict-origin-when-cross-origin"
      sandbox="allow-forms allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox"
      tabindex="0"
      data-small-groups-frame
    ></iframe>
  </section>
</div>

<script>
  import { getSmallGroupsSheetState } from '../scripts/small-groups-sheet.js';

  const layer = document.querySelector('[data-small-groups-sheet-layer]');
  const sheet = document.querySelector('[data-small-groups-sheet]');
  const closeHandle = document.querySelector('[data-small-groups-sheet-close]');
  const openButton = document.querySelector('[data-small-groups-open]');
  const backdrop = document.querySelector('[data-small-groups-sheet-backdrop]');
  const frame = document.querySelector('[data-small-groups-frame]');
  const pageContent = [
    document.querySelector('[data-site-header]'),
    ...document.querySelectorAll('.home-main > :not([data-small-groups-sheet-layer])'),
    document.querySelector('[data-bottom-dock]'),
  ].filter(Boolean);
  const previousInertStates = pageContent.map((element) => element.inert);
  let state = 'closed';

  const renderState = (action) => {
    state = getSmallGroupsSheetState(state, action);
    sheet.dataset.state = state;
  };

  const closeSheet = () => {
    if (state === 'closed') return;
    renderState('close');
    layer.hidden = true;
    document.body.classList.remove('small-groups-sheet-open');
    pageContent.forEach((element, index) => { element.inert = previousInertStates[index]; });
    openButton?.focus();
  };

  openButton?.addEventListener('click', () => {
    renderState('open');
    layer.hidden = false;
    document.body.classList.add('small-groups-sheet-open');
    pageContent.forEach((element) => { element.inert = true; });
    if (!frame.hasAttribute('src')) frame.src = frame.dataset.src;
    window.requestAnimationFrame(() => closeHandle.focus());
  });

  closeHandle?.addEventListener('click', closeSheet);
  backdrop?.addEventListener('click', closeSheet);
  document.addEventListener('keydown', (event) => {
    if (state === 'closed' || event.key !== 'Escape') return;
    closeSheet();
  });
</script>
