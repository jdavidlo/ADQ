---
const { direction = 'up-right' } = Astro.props;
const paths = {
  'up-right': 'M5 19 19 5M5 5h14v14',
  'down-left': 'M19 5 5 19M19 19H5V5',
  right: 'M4 12h16M13 5l7 7-7 7',
};
---
<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={paths[direction] ?? paths['up-right']} /></svg>
