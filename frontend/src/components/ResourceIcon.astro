---
const { kind = 'book' } = Astro.props;
---
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {kind === 'book' && <><path d="M12 5c-3-2-6-2-9-1v15c3-1 6-1 9 1 3-2 6-2 9-1V4c-3-1-6-1-9 1Z"/><path d="M12 5v15M6 8h3M15 8h3"/></>}
  {kind === 'multimedia' && <><rect x="3" y="4" width="18" height="13" rx="2"/><path d="m10 8 5 3-5 3V8ZM8 21h8M12 17v4"/></>}
  {kind === 'edecanes' && <><circle cx="12" cy="7" r="3"/><path d="M5 20v-2a7 7 0 0 1 14 0v2M4 8H2M22 8h-2"/></>}
  {kind === 'alabanza' && <><path d="M9 17V5l11-2v12M9 9l11-2"/><ellipse cx="6" cy="18" rx="3" ry="2.5"/><ellipse cx="17" cy="16" rx="3" ry="2.5"/></>}
  {kind === 'limpieza' && <><path d="m14 3-3 9M7 11l9 3-2 7-10-3 3-7ZM8 14l-2 5M11 15l-2 5M19 4v4M17 6h4"/></>}
  {kind === 'transmision' && <><rect x="3" y="7" width="12" height="11" rx="2"/><path d="m15 10 6-3v11l-6-3M7 4h4"/></>}
  {kind === 'image' && <><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8" cy="8" r="1.5"/><path d="m3 16 6-5 5 5 3-3 4 4"/></>}
</svg>
